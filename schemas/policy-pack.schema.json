{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JithuVathiath/ai-governance-continuous-assurance/schemas/policy-pack.schema.json",
  "title": "Aegis Policy Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "framework", "version", "as_of", "source_url", "disclaimer", "rules"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "framework": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date"},
    "source_url": {"type": "string", "format": "uri"},
    "disclaimer": {"type": "string", "minLength": 1},
    "digest": {"type": "string"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "description", "source_ref", "severity", "applicable_when", "requirements"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "source_ref": {"type": "string", "minLength": 1},
          "severity": {"enum": ["critical", "high", "medium", "low"]},
          "applicable_when": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "risk_tiers": {"type": "array", "items": {"type": "string"}},
              "domains": {"type": "array", "items": {"type": "string"}},
              "roles": {"type": "array", "items": {"type": "string"}},
              "geographies": {"type": "array", "items": {"type": "string"}},
              "capabilities": {"type": "array", "items": {"type": "string"}},
              "risk_factors": {"type": "array", "items": {"type": "string"}},
              "lifecycle_stages": {"type": "array", "items": {"type": "string"}}
            }
          },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title", "evidence_types", "minimum"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "title": {"type": "string", "minLength": 1},
                "evidence_types": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                "minimum": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      }
    }
  }
}
