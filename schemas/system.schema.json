{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JithuVathiath/ai-governance-continuous-assurance/schemas/system.schema.json",
  "title": "Aegis AI System Declaration",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "owner", "role", "domain", "lifecycle_stage", "intended_purpose", "decision_impact", "geographies", "capabilities", "risk_factors", "data_sensitivity", "affected_groups"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "lifecycle_stage": {"enum": ["design", "pilot", "production", "monitoring", "retired"]},
    "intended_purpose": {"type": "string", "minLength": 1},
    "decision_impact": {"type": "string", "minLength": 1},
    "geographies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "risk_factors": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "data_sensitivity": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "affected_groups": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "declared_risk_tier": {"enum": ["prohibited-review", "high", "transparency", "minimal"]},
    "vendor": {"type": "string"},
    "deployment_date": {"type": "string", "format": "date"}
  }
}
